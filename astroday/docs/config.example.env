# ASTRODAY — переменные окружения (значения секретов здесь не хранятся никогда)
# API = liz-ty666-payment-api, SCH = liz-ty666-scheduler, D7 = astroday-daily-7am-consented-notify

# --- общие (API, SCH, D7)
DATABASE_URL=${{Postgres.DATABASE_URL}}
TELEGRAM_BOT_TOKEN=                      # @Lizty666bot (API, SCH, D7)

# --- бот / API
BOT_WEBHOOK_ENABLED=true
TELEGRAM_WEBHOOK_SECRET=                 # ≥32 символа, тот же, что при setWebhook
EXTERNAL_SITE_ORIGIN=https://lizty666-stage.up.railway.app

# --- расчётный движок (API, SCH)
ASTRO_INTERNAL_TOKEN=${{liz-astro-v2-placidus.ASTRO_INTERNAL_TOKEN}}
FORECAST_SERVICE_ENABLED=true
FORECAST_START_LOCAL_DAY=2026-11-16

# --- OpenAI (API, SCH)
OPENAI_API_KEY=                          # только на сервере; в API — ссылка ${{liz-ty666-scheduler.OPENAI_API_KEY}}
OPENAI_EDITORIAL_ENABLED=true
OPENAI_EDITORIAL_MODEL=gpt-4.1
# OPENAI_REASONING_EFFORT=low            # только для моделей с рассуждением
OPENAI_TIMEOUT_MS=45000
OPENAI_MAX_CONCURRENT=3
OPENAI_DAILY_REQUEST_LIMIT=400           # защита бюджета (запросов в сутки UTC)
OPENAI_MAX_ATTEMPTS_PER_FORECAST=5
EDITORIAL_FALLBACK_POLICY=calculated_after_deadline   # или hold
EDITORIAL_FALLBACK_GRACE_MINUTES=90
# OPENAI_MODEL_TRIAL=gpt-4.1,gpt-6-luna  # разово: сравнение моделей → только в группу владельцев
# OPENAI_MODEL_TRIAL_HANDLE=april1joke

# --- доставка
LIVE_DELIVERY_ENABLED=true

# --- YooKassa (API, SCH)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_VAT_CODE=
YOOKASSA_TAX_SYSTEM_CODE=
PAYMENT_RETURN_URL=https://lizty666-stage.up.railway.app/payment-return
LIVE_RUB_PAYMENTS_ENABLED=true
YOOKASSA_PRODUCTION_CONFIRMED=true
FISCAL_RECEIPTS_VERIFIED=true
# Необязательный тестовый магазин (только для перечисленных Telegram ID):
# YOOKASSA_TEST_MODE=true
# YOOKASSA_TEST_SHOP_ID=
# YOOKASSA_TEST_SECRET_KEY=
# YOOKASSA_TEST_ALLOWED_TELEGRAM_IDS=123,456
# YOOKASSA_TEST_RECEIPTS=false

# --- уведомления владельцам (API, SCH; D7 пишет в ту же очередь)
ADMIN_NOTIFY_BOT_TOKEN=                  # @paymenlizty_bot
ADMIN_NOTIFY_CHAT_ID=                    # id закрытой группы (отрицательное число)
